# Copy to .env.local for local dev. In Amplify, set these under App settings > Environment variables.
APP_REGION=ap-south-1
CONTACT_TABLE=rm-contact-enquiries
CONTACT_FROM=no-reply@rulingmindtech.com   # must be a verified SES identity
CONTACT_TO=hello@rulingmindtech.com        # while SES is in sandbox, must also be verified
NEXT_PUBLIC_MAP_EMBED_URL=   # optional Google Maps embed URL
# HubSpot private app token (scope: crm.objects.contacts.write). Leave empty to skip CRM sync.
HUBSPOT_TOKEN=
